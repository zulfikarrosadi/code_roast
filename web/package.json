{
  "name": "coderoast",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --plugin=prettier-plugin-svelte --write",
    "lint": "prettier --plugin=prettier-plugin-svelte --write && eslint .",
    "lint-staged": "lint-staged",
    "postinstall": "cd .. && git config core.hooksPath ./web/.husky"
  },
  "lint-staged": {
    "src/lib/**/*.{js,ts,svelte}": [
      "prettier --plugin=prettier-plugin-svelte --write",
      "eslint --fix --ignore-pattern 'src/lib/components/ui/**'"
    ],
    "!src/lib/components/ui/**/*": "echo 'Skipping shadcn components'",
    "src/routes/**/*.{js,ts,svelte}": [
      "prettier --plugin=prettier-plugin-svelte --write",
      "eslint --fix"
    ],
    "src/*.{js,ts,svelte}": [
      "prettier --plugin=prettier-plugin-svelte --write",
      "eslint --fix"
    ],
    "*.{js,ts,css,scss,postcss,md,json}": [
      "prettier --plugin=prettier-plugin-svelte --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.6",
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^0.515.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.17.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.4",
    "bits-ui": "2.9.1",
    "clsx": "^2.1.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "formsnap": "^2.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "lucide-svelte": "^0.474.0",
    "mdsvex": "^0.12.3",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.38.0",
    "svelte-check": "^4.1.4",
    "svelte-sonner": "^0.3.28",
    "sveltekit-superforms": "^2.27.1",
    "tailwind-merge": "^3.0.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "valibot": "^1.1.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "dotenv": "^16.5.0",
    "mode-watcher": "^0.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
