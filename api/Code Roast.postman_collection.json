							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json()",
									"    pm.collectionVariables.set(\"email\", body.data.user.email)",
									"    pm.collectionVariables.set(\"fullname\", body.data.user.fullname)",
									"    pm.collectionVariables.set(\"access_token\", body.data.access_token)",
									"}",
